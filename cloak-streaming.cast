[0.000, "o", "48;248;242m/// move semantics are needed (`docs/06-embedding.md`).                                                              \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 108 +\u001b[38;2;117;113;94m/// that created it. The carry-over buffer's correctness depends on push/finish\u001b[38;2;248;248;242m                                      \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 109 +\u001b[38;2;117;113;94m/// being called from the same thread that created the session. Revisit for\u001b[38;2;248;248;242m                                          \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 110 +\u001b[38;2;117;113;94m/// v0.2 bindings if cross-thread move semantics are needed\u001b[38;2;248;248;242m                                                          \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 111 +\u001b[38;2;117;113;94m/// (`docs/06-embedding.md`).\u001b[38;2;248;248;242m                                                                                        \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;2;248;248;242m\u001b[2m 112\u001b[11G\u001b[22m \u001b[38;2;24"]
