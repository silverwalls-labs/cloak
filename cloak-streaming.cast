[0.000, "o", "─────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[39m \u001b[38;2;153;153;153m[Opus 5 (1M context)] \u001b[28Gsk in\u001b[34Gomplete\u001b[42G|\u001b[44Gswl-cloak-streaming\u001b[39m\r\r\n\u001b[3G\u001b[38;2;255;193;7m⏵⏵\u001b[6Gauto\u001b[11Gmode\u001b[16Gon\u001b[38;2;153;153;153m (shift+tab\u001b[30Gto\u001b[33Gcycle)\u001b[40G·\u001b[42G←\u001b[44Gfor\u001b[48Gagents\u001b[39m\r\r\n\u001b[2C\u001b[4A\u001b[?2026l"]
