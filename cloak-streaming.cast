[0.031, "o", "\u001b[?2026h\u001b[2D\u001b[4B\r\u001b[9A\u001b[38;2;78;186;101m⏺\r\u001b[1B\u001b[38;2;153;153;153m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m23\u001b[15G\u001b[22mlines,\u001b[22Gremoved\u001b[30G\u001b[1m7\u001b[32G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;2;248;248;242m\u001b[2m 229 \u001b[22m             straddle_zone.\u001b[38;2;166;226;46mmin\u001b[38;2;248;248;242m(first_unresolvable)\r\u001b[5C\u001b[1B\u001b[2m 230 \u001b[22m         };\r\u001b[1B\u001b[39m     \u001b[38;2;248;248;242m\u001b[2m 231 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B  \u001b[6G\u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 232 +\u001b[38;2;248;248;242m        \u001b[38;2;117;113;94m// 4b. Adjust carry_start so no confirmed match spans the boundary.\u001b[38;2;248;248;242m                                          \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 233 +\u001b[38;2;248;248;242m        \u001b[38;2;117;113;94m//     A match that starts before carry_start but ends after it cannot\u001b[38;2;248;248;242m                                       \u001b[49m\u001b[39m\u001b[K\r\u001b[3C\u001b[1B  \u001b[38;2;80;200;80m\u001b[48;2;2;40;0m 234 +\u001b[38;2;248;248;242m        \u001b[38;2;117;113;94m//     be emitted safely: an unresolvable candidate in the overlap zone\u001b[38;2;248;248;242m     "]
